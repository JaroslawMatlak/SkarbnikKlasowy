<Window x:Class="SkarbnikKlasowy.Windows.StudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uczniowie"
        Width="1000"
        Height="550"
        MinWidth="800"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

	<Grid Background="#F4F5F7">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Nagłówek -->

		<TextBlock Grid.Row="0"
                   Text="Uczniowie"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#202124"
                   Margin="30,25,30,20"/>

		<!-- Lista -->

		<Border Grid.Row="1"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Margin="30,0,30,20">

			<DataGrid x:Name="StudentsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      BorderThickness="0"
                      Background="White"
                      RowHeight="36"
                      MouseDoubleClick="StudentsGrid_MouseDoubleClick">

				<DataGrid.Columns>

					<DataGridTextColumn Header="Nazwisko"
                                        Binding="{Binding SecondName}"
                                        Width="*"/>

					<DataGridTextColumn Header="Imię"
                                        Binding="{Binding Name}"
                                        Width="*"/>

					<DataGridTextColumn Header="Suma wpłat"
                                        Binding="{Binding TotalPaymentsDisplay}"
                                        Width="150"/>

					<DataGridTextColumn Header="Nieobsłużone nadpłaty"
                                        Binding="{Binding UnhandledOverpaymentsDisplay}"
                                        Width="180"/>

					<!-- Nieopłacone cele -->

					<DataGridTemplateColumn Header="Nieopłacone cele"
                                            Width="150">

						<DataGridTemplateColumn.CellTemplate>

							<DataTemplate>

								<TextBlock Text="{Binding UnpaidGoalsDisplay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">

									<TextBlock.Style>

										<Style TargetType="TextBlock">

											<Setter Property="Foreground"
                                                    Value="Green"/>

											<Style.Triggers>

												<DataTrigger Binding="{Binding HasUnpaidGoals}"
                                                             Value="True">

													<Setter Property="Foreground"
                                                            Value="Red"/>

												</DataTrigger>

											</Style.Triggers>

										</Style>

									</TextBlock.Style>

								</TextBlock>

							</DataTemplate>

						</DataGridTemplateColumn.CellTemplate>

					</DataGridTemplateColumn>

				</DataGrid.Columns>

			</DataGrid>

		</Border>

		<!-- Przyciski -->

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="30,0,30,25">

			<Button Content="Edytuj"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="EditStudent_Click"/>

			<Button Content="Usuń"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="DeleteStudent_Click"/>

			<Button Content="+ Dodaj ucznia"
                    Width="150"
                    Height="40"
                    Click="AddStudent_Click"/>

		</StackPanel>

	</Grid>

</Window>