<Window x:Class="SkarbnikKlasowy.Windows.OverpaymentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nadpłaty"
        Width="900"
        Height="550"
        MinWidth="700"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

	<Grid Background="#F4F5F7"
          Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>


		<!-- Nagłówek -->
		<TextBlock Grid.Row="0"
                   Text="Nadpłaty"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#202124"
                   Margin="0,0,0,20"/>


		<!-- Lista -->
		<DataGrid x:Name="OverpaymentsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="32">

			<DataGrid.Columns>

				<DataGridTextColumn Header="Uczeń"
                                    Binding="{Binding StudentName}"
                                    Width="250"/>

				<DataGridTextColumn Header="Tytuł"
                                    Binding="{Binding GoalName}"
                                    Width="*"/>

				<DataGridTextColumn Header="Wpłacono"
                                    Binding="{Binding PaidDisplay}"
                                    Width="110"/>

				<DataGridTextColumn Header="Wymagane"
                                    Binding="{Binding RequiredDisplay}"
                                    Width="110"/>

				<DataGridTextColumn Header="Dostępna nadpłata"
                                    Binding="{Binding AvailableDisplay}"
                                    Width="150"/>

			</DataGrid.Columns>

		</DataGrid>


		<!-- Przyciski -->
		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

			<Button Content="Stwórz modyfikator"
            Width="170"
            Height="40"
            Margin="0,0,10,0"
            Click="CreateModifier_Click"/>

				<Button Content="Obsłuż nadpłatę"
            Width="160"
            Height="40"
            Margin="0,0,10,0"
            Click="HandleOverpayment_Click"/>

				<Button Content="Odśwież"
            Width="110"
            Height="40"
            Click="RefreshButton_Click"/>
			</StackPanel>

	</Grid>

</Window>