<Window x:Class="SkarbnikKlasowy.Windows.OverpaymentRedirectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Przekieruj nadpłatę"
        Width="500"
        Height="380"
        MinWidth="450"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

	<Grid Background="#F4F5F7"
          Margin="25">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
                   Text="Przekieruj nadpłatę"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#202124"
                   Margin="0,0,0,20"/>

		<TextBlock Grid.Row="1"
                   x:Name="AvailableTextBlock"
                   FontSize="16"
                   Foreground="#202124"
                   Margin="0,0,0,15"/>

		<TextBlock Grid.Row="2"
                   Text="Kwota do przekierowania:"
                   FontSize="14"
                   Margin="0,0,0,5"/>

		<TextBox Grid.Row="3"
                 x:Name="AmountTextBox"
                 Height="35"
                 FontSize="16"
                 Padding="8"
                 Margin="0,0,0,15"/>

		<StackPanel Grid.Row="4">

			<TextBlock Text="Przekieruj na tytuł:"
                       FontSize="14"
                       Margin="0,0,0,5"/>

			<ComboBox x:Name="GoalComboBox"
                      Height="35"
                      FontSize="15"
                      DisplayMemberPath="Name"/>

		</StackPanel>

		<StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

			<Button Content="Anuluj"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

			<Button Content="Przekieruj"
                    Width="120"
                    Height="38"
                    Click="RedirectButton_Click"/>

		</StackPanel>

	</Grid>
</Window>