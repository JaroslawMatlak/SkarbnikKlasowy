<Window x:Class="SkarbnikKlasowy.Windows.GoalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tytuły"
        Width="1150"
        Height="550"
        MinWidth="900"
        MinHeight="400"
        WindowStartupLocation="CenterOwner">

	<Grid Background="#F4F5F7">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Nagłówek -->

		<TextBlock Grid.Row="0"
                   Text="Tytuły"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#202124"
                   Margin="30,25,30,20"/>

		<!-- Lista -->

		<Border Grid.Row="1"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Margin="30,0,30,20">

			<DataGrid x:Name="GoalsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      BorderThickness="0"
                      Background="White"
                      RowHeight="36">

				<DataGrid.Columns>

					<DataGridTextColumn Header="Nazwa"
                                        Binding="{Binding Name}"
                                        Width="*"/>

					<DataGridTextColumn Header="Kwota"
                                        Binding="{Binding Amount, StringFormat={}{0:F2} zł}"
                                        Width="110"/>

					<DataGridTextColumn Header="Oczekiwane wpływy"
                                        Binding="{Binding ExpectedAmountDisplay}"
                                        Width="160"/>

					<DataGridTextColumn Header="Suma wpływów"
                                        Binding="{Binding TotalIncomeDisplay}"
                                        Width="150"/>

					<DataGridTextColumn Header="Nieopłaceni"
                                        Binding="{Binding UnpaidStudentsDisplay}"
                                        Width="110"/>

					<DataGridTextColumn Header="Data utworzenia"
                                        Binding="{Binding CreationDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                        Width="160"/>

					<DataGridTextColumn Header="Data zakończenia"
                            Binding="{Binding EndDateDisplay}"
                            Width="150"/>

					<DataGridTemplateColumn Header="Ręczne zakończenie"
                        Width="150">

						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<CheckBox IsChecked="{Binding IsManuallyClosed, Mode=OneWay}"
                      IsEnabled="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>

					</DataGridTemplateColumn>

				</DataGrid.Columns>

			</DataGrid>

		</Border>

		<!-- Przyciski -->

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="30,0,30,25">

			<Button Content="Edytuj"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="EditGoal_Click"/>

			<Button Content="Usuń"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="DeleteGoal_Click"/>

			<Button Content="+ Dodaj tytuł"
                    Width="150"
                    Height="40"
                    Click="AddGoal_Click"/>

		</StackPanel>

	</Grid>

</Window>