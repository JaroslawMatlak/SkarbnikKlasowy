<Window x:Class="SkarbnikKlasowy.Windows.GoalEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tytuł"
        Width="468"
        Height="354"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

	<Grid Background="#F4F5F7"
          Margin="25">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
                   Text="Dane tytułu"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#202124"
                   Margin="0,0,0,25"/>

		<!-- Nazwa -->
		<Grid Grid.Row="1"
              Margin="0,0,0,15">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="110"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Column="0"
                       Text="Nazwa:"
                       VerticalAlignment="Center"
                       FontSize="16"/>

			<TextBox x:Name="NameTextBox"
                     Grid.Column="1"
                     Height="32"
                     FontSize="16"
                     Padding="6,3"/>

		</Grid>

		<!-- Kwota -->
		<Grid Grid.Row="2"
              Margin="0,0,0,15">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="110"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Column="0"
                       Text="Kwota:"
                       VerticalAlignment="Center"
                       FontSize="16"/>

			<TextBox x:Name="AmountTextBox"
                     Grid.Column="1"
                     Height="32"
                     FontSize="16"
                     Padding="6,3"/>



		</Grid>
		<Grid Grid.Row="3"
            Margin="0,0,0,15">
			<TextBlock Grid.Row="4"
            Grid.Column="0"
           Text="Data zakończenia:"
           VerticalAlignment="Center"
           Margin="0,0,10,0"/>

			<DatePicker x:Name="EndDatePicker"
            HorizontalAlignment="Left" Margin="200,0,0,0" Width="200"/>

		</Grid>
		<Grid Grid.Row="4"
            Margin="0,0,0,15">


			<CheckBox x:Name="ManualCloseCheckBox"
              Grid.Row="5"
              Grid.Column="1"
              Content="Ręcznie zakończony"
              VerticalAlignment="Center"/>
		</Grid>

		<!-- Przyciski -->
		<Grid Grid.Row="5">
			<StackPanel 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

				<Button Content="Anuluj"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

				<Button Content="Zapisz"
                    Width="100"
                    Height="38"
                    IsDefault="True"
                    Click="SaveButton_Click"/>

			</StackPanel>
		</Grid>

	</Grid>

</Window>