<Window x:Class="SkarbnikKlasowy.Windows.PaymentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Płatności"
        Width="1050"
        Height="650"
        MinWidth="850"
        MinHeight="450"
        WindowStartupLocation="CenterOwner">

	<Grid Background="#F4F5F7">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Nagłówek -->
		<Grid Grid.Row="0"
              Margin="30,25,30,20">

			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<TextBlock Grid.Column="0"
                       Text="Płatności"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#202124"
                       VerticalAlignment="Center"/>

			<StackPanel Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,0,0,10">

				<Button Content="Importuj płatności"
            Width="150"
            Height="35"
            Click="ImportPayments_Click"/>

				<Button Content="Przypisz automatycznie"
            Width="180"
            Height="35"
            Margin="10,0,0,0"
            Click="AutoAssignPayments_Click"/>

			</StackPanel>

		</Grid>

		<!-- Lista -->
		<Border Grid.Row="1"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Margin="30,0,30,20">

			<DataGrid x:Name="PaymentsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      BorderThickness="0"
                      Background="White">

				<DataGrid.Columns>


					<DataGridTemplateColumn Header=""
                        Width="45">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<TextBlock Text="⚠"
                                   Foreground="Red"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Visibility"
                                Value="Collapsed"/>

											<Style.Triggers>
												<DataTrigger Binding="{Binding HasProblem}"
                                         Value="True">
													<Setter Property="Visibility"
                                        Value="Visible"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTextColumn Header="Data"
                                        Binding="{Binding CreationDate,
                                            StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                        Width="150"/>

					<DataGridTextColumn Header="Kwota"
                                        Binding="{Binding Amount,
                                            StringFormat={}{0:F2} zł}"
                                        Width="110"/>

					<DataGridTextColumn Header="Opis"
                                        Binding="{Binding Name}"
                                        Width="*"/>

					<DataGridTextColumn Header="Uczeń"
                                        Binding="{Binding StudentDisplayName}"
                                        Width="200"/>

					<DataGridTextColumn Header="Tytuł"
                                        Binding="{Binding GoalDisplayName}"
                                        Width="180"/>

				</DataGrid.Columns>

			</DataGrid>

		</Border>

		<!-- Przyciski -->
		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="30,0,30,25">

			<Button Content="Edytuj przypisanie"
                    Width="160"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="EditPayment_Click"/>

		</StackPanel>

	</Grid>

</Window>