<Window x:Class="SkarbnikKlasowy.Windows.GoalModifiersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modyfikatory tytułów"
        Width="850"
        Height="550"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="20">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
                   Text="Modyfikatory tytułów"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

		<DataGrid x:Name="ModifiersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

			<DataGrid.Columns>

				<DataGridTextColumn Header="Uczeń"
                                    Binding="{Binding StudentName}"
                                    Width="250"/>

				<DataGridTextColumn Header="Tytuł"
                                    Binding="{Binding GoalName}"
                                    Width="*"/>

				<DataGridTextColumn Header="Zmodyfikowana kwota"
                                    Binding="{Binding ModifiedValue}"
                                    Width="180"/>

			</DataGrid.Columns>

		</DataGrid>

		<StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

			<Button Content="Dodaj"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="AddModifier_Click"/>

			<Button Content="Edytuj"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="EditModifier_Click"/>

			<Button Content="Usuń"
                    Width="100"
                    Height="35"
                    Click="DeleteModifier_Click"/>

		</StackPanel>

	</Grid>
</Window>